# Production env template for RSH on Linux VM / Russian cloud
# Copy to `.env.production` on the target server.
# Do not commit real secrets.

NODE_ENV=production
APP_URL=https://your-domain.ru
COOKIE_DOMAIN=your-domain.ru

# Managed PostgreSQL or private PostgreSQL host
DATABASE_URL=postgresql://RSH_USER:RSH_PASSWORD@DB_HOST:5432/rsh?sslmode=require
DIRECT_URL=postgresql://RSH_USER:RSH_PASSWORD@DB_HOST:5432/rsh?sslmode=require

# Managed Redis / Valkey with TLS if provider supports it
REDIS_URL=rediss://default:REDIS_PASSWORD@REDIS_HOST:6379

JWT_ACCESS_SECRET=replace-with-random-64-plus-character-secret
JWT_REFRESH_SECRET=replace-with-different-random-64-plus-character-secret
JWT_KEY_ID=rsh-prod-v1
REFRESH_TOKEN_PEPPER=replace-with-random-32-plus-character-pepper
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Payment provider for Russia-ready production
PAYMENT_PROVIDER=cloudpayments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CURRENCY=rub
CLOUDPAYMENTS_PUBLIC_ID=replace-with-cloudpayments-public-id
CLOUDPAYMENTS_API_SECRET=replace-with-cloudpayments-api-secret

STORE_USD_TO_RUB_RATE=90

# Stable first production mode
UPLOAD_PROVIDER=local
UPLOADTHING_TOKEN=
UPLOADTHING_APP_ID=

SENTRY_DSN=
SENTRY_ERROR_SAMPLE_RATE=1
SENTRY_WARNING_SAMPLE_RATE=0.25
SENTRY_INFO_SAMPLE_RATE=0.05
