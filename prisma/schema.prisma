generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
}

enum GarmentType {
  TSHIRT
  HOODIE
  SWEATSHIRT
  SHORTS
  PANTS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String
  role               Role               @default(USER)
  isBlocked          Boolean            @default(false)
  twoFactorEnabled   Boolean            @default(false)
  twoFactorSecretEnc String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  sessions           Session[]
  refreshTokens      RefreshToken[]
  cart               Cart?
  wishlistItems      WishlistItem[]
  orders             Order[]
  designs            CustomizationDesign[]
  auditLogs          AuditLog[]         @relation("AuditActor")
  adminActions       AdminAction[]      @relation("AdminActor")
  backupCodes        BackupCode[]
  orderFilterPresets AdminOrderFilterPreset[]
  userFilterPresets  AdminUserFilterPreset[]
  productFilterPresets AdminProductFilterPreset[]
  contentFilterPresets AdminContentFilterPreset[]
  logFilterPresets   AdminLogFilterPreset[]
  sessionFilterPresets AdminSessionFilterPreset[]
  webhookFilterPresets AdminWebhookFilterPreset[]

  @@index([createdAt])
  @@index([role, isBlocked])
}

model AdminOrderFilterPreset {
  id            String      @id @default(cuid())
  adminId       String
  name          String
  search        String?
  status        OrderStatus?
  dateFrom      String?
  dateTo        String?
  minTotalCents Int?
  maxTotalCents Int?
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  admin         User        @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminUserFilterPreset {
  id            String   @id @default(cuid())
  adminId       String
  name          String
  search        String?
  role          Role?
  isBlocked     Boolean?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admin         User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminProductFilterPreset {
  id            String        @id @default(cuid())
  adminId       String
  name          String
  search        String?
  brand         String?
  categoryId    String?
  status        ProductStatus?
  sortBy        String?
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  admin         User          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminContentFilterPreset {
  id            String        @id @default(cuid())
  adminId       String
  name          String
  search        String?
  status        ContentStatus?
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  admin         User          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminLogFilterPreset {
  id            String   @id @default(cuid())
  adminId       String
  name          String
  action        String?
  targetType    String?
  search        String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admin         User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminSessionFilterPreset {
  id            String        @id @default(cuid())
  adminId       String
  name          String
  search        String?
  status        SessionStatus?
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  admin         User          @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model AdminWebhookFilterPreset {
  id            String   @id @default(cuid())
  adminId       String
  name          String
  eventType     String?
  processed     Boolean?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  admin         User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, name])
  @@index([adminId, updatedAt])
}

model BackupCode {
  id         String   @id @default(cuid())
  userId     String
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Session {
  id             String        @id @default(cuid())
  userId         String
  userAgent      String?
  ipAddress      String?
  deviceType     String?
  status         SessionStatus @default(ACTIVE)
  lastSeenAt     DateTime      @default(now())
  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]

  @@index([userId, status])
  @@index([expiresAt])
}

model RefreshToken {
  id          String   @id @default(cuid())
  userId      String
  sessionId   String
  tokenHash   String   @unique
  familyId    String
  isRevoked   Boolean  @default(false)
  replacedBy  String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([sessionId, isRevoked])
  @@index([expiresAt])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
}

model Product {
  id                String                @id @default(cuid())
  brand             String                @default("RSH")
  name              String
  slug              String                @unique
  description       String
  shortDescription  String?
  tags              String[]
  status            ProductStatus         @default(DRAFT)
  categoryId        String
  basePriceCents    Int
  currency          String                @default("USD")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants          ProductVariant[]
  images            ProductImage[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  orderItems        OrderItem[]
  inventoryItems    InventoryItem[]

  @@index([status, categoryId])
  @@index([brand])
  @@index([name])
  @@index([createdAt])
}

model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  name            String
  sku             String      @unique
  color           String
  size            String
  priceCents      Int
  currency        String      @default("USD")
  isDefault       Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  inventory       InventoryItem?

  @@unique([productId, color, size])
  @@index([productId])
}

model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  url         String
  alt         String
  width       Int
  height      Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model InventoryItem {
  id               String         @id @default(cuid())
  productId        String
  variantId        String         @unique
  quantity         Int
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Cart {
  id          String     @id @default(cuid())
  userId      String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id                String               @id @default(cuid())
  cartId            String
  productId         String
  variantId         String
  quantity          Int
  customizationId   String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cart              Cart                 @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product           Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  customization     CustomizationDesign? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@unique([cartId, variantId, customizationId])
  @@index([cartId])
}

model WishlistItem {
  id          String         @id @default(cuid())
  userId      String
  productId   String
  variantId   String?
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Order {
  id                    String         @id @default(cuid())
  userId                String
  status                OrderStatus    @default(PENDING)
  subtotalCents         Int
  shippingCents         Int
  taxCents              Int
  discountCents         Int            @default(0)
  totalCents            Int
  currency              String         @default("USD")
  stripeCheckoutId      String?        @unique
  shippingAddressJson   Json
  billingAddressJson    Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  user                  User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                 OrderItem[]
  payments              Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id                  String               @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  quantity            Int
  unitPriceCents      Int
  totalPriceCents     Int
  currency            String               @default("USD")
  customizationId     String?
  order               Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant             ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  customization       CustomizationDesign? @relation(fields: [customizationId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id                    String          @id @default(cuid())
  orderId               String
  provider              PaymentProvider
  status                PaymentStatus
  amountCents           Int
  currency              String          @default("USD")
  stripePaymentIntentId String?         @unique
  stripeChargeId        String?         @unique
  providerPayload       Json?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

model StripeEventLog {
  id            String   @id @default(cuid())
  eventId       String   @unique
  eventType     String
  processedAt   DateTime?
  payload       Json
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
}

model CustomizationDesign {
  id                String        @id @default(cuid())
  userId            String
  garmentType       GarmentType
  garmentColor      String
  canvasJson        Json
  previewUrl        String
  previewWidth      Int
  previewHeight     Int
  status            String        @default("ACTIVE")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  assets            DesignAsset[]
  cartItems         CartItem[]
  orderItems        OrderItem[]

  @@index([userId, createdAt])
}

model DesignAsset {
  id          String               @id @default(cuid())
  designId    String
  url         String
  mimeType    String
  width       Int
  height      Int
  fileSize    Int
  createdAt   DateTime             @default(now())
  design      CustomizationDesign  @relation(fields: [designId], references: [id], onDelete: Cascade)

  @@index([designId])
}

model ContentPost {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  content       String
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AdminAction {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String
  targetId    String
  details     Json?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

